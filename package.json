{
  "name": "merchant-reality-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node backend/bundle-api.mjs && tsc --noEmit && vite build && vite build --config vite.console.config.ts",
    "preview": "vite preview",
    "api": "tsx backend/src/server.ts",
    "check:api": "MRE_CASE_STORE=memory tsx backend/src/selfcheck.ts",
    "selftest": "tsx scripts/selftest.ts",
    "test:dataset": "node --import tsx scripts/test-dataset-import.ts",
    "samples": "tsx scripts/export-samples.ts",
    "test": "npm run -s test:stats && npm run -s selftest >/dev/null && npm run -s check:api && npm run -s test:dataset && npm run -s security && npm run -s adversarial && npm run -s lint:noscript",
    "test:stats": "MRE_CASE_STORE=memory tsx tests/run.ts",
    "adversarial": "tsx scripts/adversarial.ts",
    "security": "tsx scripts/security.ts",
    "lint:noscript": "! grep -rnE \"(scenario|sc)\\.id ===\" frontend/src",
    "user:add": "tsx scripts/user-add.ts",
    "dev:users": "tsx scripts/dev-users.ts",
    "mre": "tsx cli/mre.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "train": "tsx scripts/train-model.ts",
    "redteam": "tsx scripts/redteam.ts"
  },
  "dependencies": {
    "@stdlib/math-base-special-betainc": "^0.2.3",
    "@stdlib/math-base-special-betaincinv": "^0.2.3",
    "@stdlib/math-base-special-erfc": "^0.2.5",
    "@stdlib/math-base-special-erfcinv": "^0.2.4",
    "@stdlib/math-base-special-gammainc": "^0.3.1",
    "@stdlib/math-base-special-gammaincinv": "^0.2.3",
    "@stdlib/math-base-special-gammaln": "^0.3.1",
    "@types/three": "^0.187.0",
    "@xyflow/react": "^12.12.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
